{
  "name": "doudou-pindou",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:xhs": "tsc --noEmit -p tsconfig.xhs.json && vite build --mode xhs",
    "pack:xhs": "node scripts/pack-xhs.mjs",
    "preview": "vite preview --port 5191 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.xhs.json"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
